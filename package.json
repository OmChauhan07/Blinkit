{
  "name": "blinkit-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Blinkit Quick Commerce - Separated Web and Mobile App Instances",
  "scripts": {
    "dev:web": "npm run dev --prefix web",
    "dev:mobile": "npm start --prefix mobile",
    "dev:mobile:tunnel": "npm run tunnel --prefix mobile",
    "dev:mobile:web": "npm run web --prefix mobile",
    "dev:mobile:android": "npm run android --prefix mobile",
    "dev:mobile:ios": "npm run ios --prefix mobile",
    "build:web": "npm run build --prefix web",
    "test:web": "npm run lint --prefix web",
    "test:mobile": "npm run typecheck --prefix mobile",
    "test:responsive": "npm run test:responsive --prefix mobile",
    "test": "npm run test:web && npm run test:mobile",
    "install:web": "npm install --prefix web --legacy-peer-deps",
    "install:mobile": "npm install --prefix mobile --legacy-peer-deps",
    "install:all": "npm run install:web && npm run install:mobile"
  },
  "keywords": [
    "blinkit",
    "quick-commerce",
    "react",
    "react-native",
    "expo",
    "vite"
  ],
  "author": "",
  "license": "ISC"
}
